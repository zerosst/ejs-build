--- a/src/cpu/arm7_intf.cpp
+++ b/src/cpu/arm7_intf.cpp
@@ -54,8 +54,14 @@
 	DebugCPU_ARM7Initted = 1;
 	
 	for (INT32 i = 0; i < 3; i++) {
 		membase[i] = (UINT8**)malloc(ARM7_PAGE_COUNT * sizeof(UINT8*));
+		/* ★ 必须清零: 读/写/取指三条路径都是 `if (membase[X][page] != NULL)` 才走映射 ——
+		 *   也就是"未映射 == NULL"是这里的**约定**。malloc 不清零 -> 表里全是垃圾指针, 几乎都不是
+		 *   NULL -> 被当成"已映射", 拿垃圾指针解引用。原生构建里通常只是读到乱数据(所以上游多年
+		 *   没发现), 而 wasm 里一越界就 trap —— 实测 kov2 跑 ~764 帧后崩在
+		 *   `Arm7_program_read_byte_32le` 就是这条。FBNeo 在**同一处**补了下面这行, 这里照抄。 */
+		memset(membase[i], 0, ARM7_PAGE_COUNT * sizeof(UINT8*));
 	}
 
 	CpuCheatRegister(num, &Arm7CheatCpuConfig);
 }
